{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun", "node"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "rythra": ["./index.ts"],
      "@rythra/core": ["./packages/core/src/index.ts"],
      "@rythra/core/*": ["./packages/core/src/*"],
      "@rythra/connectors": ["./packages/connectors/src/index.ts"],
      "@rythra/connectors/*": ["./packages/connectors/src/*.ts"],
      "@rythra/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["index.ts", "packages/**/*.ts", "example/**/*.ts"],
  "exclude": ["typedocs", "docs", "node_modules", "dist"]
}
