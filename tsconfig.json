{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "rythra": ["index.ts"],
      "@rythra/core": ["packages/core/src/index.ts"],
      "@rythra/core/*": ["packages/core/src/*"],
      "@rythra/connector-discordjs": ["packages/connectors/discordjs/src/index.ts"],
      "@rythra/connector-discordjs/*": ["packages/connectors/discordjs/src/*"],
      "@rythra/connector-eris": ["packages/connectors/eris/src/index.ts"],
      "@rythra/connector-eris/*": ["packages/connectors/eris/src/*"],
      "@rythra/connector-oceanic": ["packages/connectors/oceanic/src/index.ts"],
      "@rythra/connector-oceanic/*": ["packages/connectors/oceanic/src/*"],
      "@rythra/connector-seyfert": ["packages/connectors/seyfert/src/index.ts"],
      "@rythra/connector-seyfert/*": ["packages/connectors/seyfert/src/*"],
      "@rythra/*": ["packages/*/src/index.ts", "packages/connectors/*/src/index.ts"]
    }
  },
  "include": ["index.ts", "packages/**/*.ts", "example/**/*.ts"],
  "exclude": ["typedocs", "docs", "node_modules", "dist"]
}
