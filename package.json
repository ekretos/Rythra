{
  "name": "rythra",
  "version": "0.3.0",
  "private": false,
  "description": "A modular, framework-agnostic Lavalink client for modern TypeScript runtimes.",
  "workspaces": [
    "packages/*",
    "packages/connectors/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connectors/discordjs": {
      "types": "./dist/connectors/discordjs.d.ts",
      "import": "./dist/connectors/discordjs.js"
    },
    "./connectors/eris": {
      "types": "./dist/connectors/eris.d.ts",
      "import": "./dist/connectors/eris.js"
    },
    "./connectors/oceanic": {
      "types": "./dist/connectors/oceanic.d.ts",
      "import": "./dist/connectors/oceanic.js"
    },
    "./connectors/seyfert": {
      "types": "./dist/connectors/seyfert.d.ts",
      "import": "./dist/connectors/seyfert.js"
    },
    "./connectors/lunibee": {
      "types": "./dist/connectors/lunibee.d.ts",
      "import": "./dist/connectors/lunibee.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:packages && bun run build:facade && node scripts/sync-dist.mjs && bun run build:docs",
    "build:packages": "bun run build:types && bun run build:core && bun run build:protocol && bun run build:plugins && bun run build:metrics && bun run build:persistence && bun run build:connectors",
    "build:core": "bun --filter @rythra/core build",
    "build:types": "bun --filter @rythra/types build",
    "build:protocol": "bun --filter @rythra/protocol build",
    "build:metrics": "bun --filter @rythra/metrics build",
    "build:persistence": "bun --filter @rythra/persistence build",
    "build:plugins": "bun --filter @rythra/plugins build",
    "build:connectors": "bun --filter @rythra/connectors build",
    "build:facade": "tsc --project tsconfig.facade.json",
    "build:docs": "bun install --cwd scripts/typedoc && bun scripts/typedoc/node_modules/.bin/typedoc --options typedoc.json --tsconfig tsconfig.json && node scripts/postprocess-docs.js",
    "publish:all": "node scripts/publish-all.mjs",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:versions": "node scripts/check-package-versions.mjs",
    "check:dist": "node scripts/check-esm.mjs && bun run check:consumer",
    "check:consumer": "tsc -p test/consumer/tsconfig.json",
    "check:packages": "bun run check:boundaries && bun run check:versions"
  },
  "dependencies": {
    "@rythra/core": "workspace:*",
    "@rythra/connectors": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5 <8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}