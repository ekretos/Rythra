{
  "name": "rythra",
  "version": "0.1.0",
  "private": false,
  "description": "A modular, framework-agnostic Lavalink client for modern TypeScript runtimes.",
  "workspaces": [
    "packages/*",
    "packages/connectors/*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "bun run build:packages && bun run build:facade && bun run build:docs",
    "build:packages": "bun run build:core && bun run build:protocol && bun run build:persistence && bun run build:metrics && bun run build:plugins && bun run build:types && bun run build:connector-discordjs",
    "build:core": "tsup packages/core/src/index.ts --format esm --dts --out-dir packages/core/dist",
    "build:protocol": "tsup packages/protocol/src/index.ts --format esm --dts --out-dir packages/protocol/dist",
    "build:persistence": "tsup packages/persistence/src/index.ts --format esm --dts --out-dir packages/persistence/dist",
    "build:metrics": "tsup packages/metrics/src/index.ts --format esm --dts --out-dir packages/metrics/dist",
    "build:plugins": "tsup packages/plugins/src/index.ts --format esm --dts --out-dir packages/plugins/dist",
    "build:types": "tsup packages/types/src/index.ts --format esm --dts --out-dir packages/types/dist",
    "build:connector-discordjs": "tsup packages/connectors/discordjs/src/index.ts --format esm --dts --out-dir packages/connectors/discordjs/dist",
    "build:facade": "tsup index.ts --format esm,cjs --dts --out-dir dist",
    "build:docs": "typedoc && node scripts/postprocess-docs.js",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "test:file": "bun --watch run example/bot.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:versions": "node scripts/check-package-versions.mjs",
    "check:packages": "bun run check:boundaries && bun run check:versions"
  },
  "dependencies": {
    "@rythra/core": "workspace:*",
    "@rythra/connector-discordjs": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5 <8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "discord.js": "^14.27.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
