{
  "name": "rythra",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "version": "0.0.2",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:ts && bun run build:docs",
    "build:ts": "tsup && bun x tsc -p tsconfig.dist.json",
    "build:docs": "typedoc && node scripts/postprocess-docs.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "bun run build:ts"
  },
  "dependencies": {
    "@types/bun": "latest",
    "discord.js": "^14.25.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typedoc-plugin-markdown": "^4.4.2",
    "typescript-eslint": "^8.56.1"
  }
}