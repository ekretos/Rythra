{
  "name": "rythra",
  "version": "0.2.0",
  "private": false,
  "description": "A modular, framework-agnostic Lavalink client for modern TypeScript runtimes.",
  "workspaces": [
    "packages/*",
    "packages/connectors/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connectors/discordjs": {
      "types": "./dist/connectors/discordjs/index.d.ts",
      "import": "./dist/connectors/discordjs/index.js"
    },
    "./connectors/eris": {
      "types": "./dist/connectors/eris/index.d.ts",
      "import": "./dist/connectors/eris/index.js"
    },
    "./connectors/oceanic": {
      "types": "./dist/connectors/oceanic/index.d.ts",
      "import": "./dist/connectors/oceanic/index.js"
    },
    "./connectors/seyfert": {
      "types": "./dist/connectors/seyfert/index.d.ts",
      "import": "./dist/connectors/seyfert/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:packages && bun run build:facade && node scripts/sync-dist.mjs && bun run build:docs",
    "build:packages": "bun run build:core && bun run build:protocol && bun run build:plugins && bun run build:connector-discordjs && bun run build:connector-eris && bun run build:connector-oceanic && bun run build:connector-seyfert",
    "build:core": "bun --filter @rythra/core build",
    "build:protocol": "bun --filter @rythra/protocol build",
    "build:plugins": "bun --filter @rythra/plugins build",
    "build:connector-discordjs": "bun --filter @rythra/connector-discordjs build",
    "build:connector-eris": "bun --filter @rythra/connector-eris build",
    "build:connector-oceanic": "bun --filter @rythra/connector-oceanic build",
    "build:connector-seyfert": "bun --filter @rythra/connector-seyfert build",
    "build:facade": "tsc --project tsconfig.facade.json",
    "build:docs": "typedoc && node scripts/postprocess-docs.js",
    "publish:all": "node scripts/publish-all.mjs",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "test:file": "bun --watch run example/bot.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:versions": "node scripts/check-package-versions.mjs",
    "check:packages": "bun run check:boundaries && bun run check:versions"
  },
  "dependencies": {
    "@rythra/core": "workspace:*",
    "@rythra/connector-discordjs": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5 <8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "discord.js": "^14.27.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.68.0"
  }
}